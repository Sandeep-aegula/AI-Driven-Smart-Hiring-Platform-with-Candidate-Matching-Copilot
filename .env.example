# Outbound recruiter-decision email settings.
# The candidate email parsed from the resume is the recipient; SMTP_FROM_EMAIL is your sender address.
# Example SMTP host: smtp.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_USE_TLS=true

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=hirepilot_db
MYSQL_USER=hirepilot_user
MYSQL_PASSWORD=your-mysql-password

DATABASE_URL=mysql+aiomysql://hirepilot_user:your-mysql-password@localhost:3306/hirepilot_db